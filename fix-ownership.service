[Unit]
Description=Mount root-owned sudo from baked sources (host rootfs uid is wrong)
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The host extraction sets every file to the host uid and virtiofs ignores
# chown, so /etc/sudoers (owned by 501) is rejected by sudo. The image bakes
# correct root-owned, setuid sources under /opt/piebox-image/sudo; copy them
# to a tmpfs (where ownership+setuid work) and bind-mount into place. No
# chown/chmod logic lives here — it is all in the Dockerfile now.
ExecStart=/bin/sh -c '\
  mkdir -p /run/piebox-sudo /run/piebox-etc && \
  mount -t tmpfs tmpfs /run/piebox-sudo && \
  mount -t tmpfs tmpfs /run/piebox-etc && \
  cp -a /opt/piebox-image/sudo/sudo /run/piebox-sudo/sudo && \
  cp -a /opt/piebox-image/sudo/sudoers /opt/piebox-image/sudo/sudo.conf /run/piebox-etc/ && \
  cp -a /opt/piebox-image/sudo/sudoers.d /run/piebox-etc/ && \
  mount --bind /run/piebox-sudo/sudo /usr/bin/sudo && \
  mount --bind /run/piebox-etc/sudoers /etc/sudoers && \
  mount --bind /run/piebox-etc/sudo.conf /etc/sudo.conf && \
  mount --bind /run/piebox-etc/sudoers.d /etc/sudoers.d'

[Install]
WantedBy=sysinit.target
