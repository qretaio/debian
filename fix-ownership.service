[Unit]
Description=Fix ownership of files written by the unprivileged host
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The zygote rootfs is extracted on an unprivileged macOS host, so every file
# is owned by the host uid (501) rather than root. sudo rejects a non-root
# owned /etc/sudoers; sshd rejects non-root host keys. Fix the few files that
# care, inside the guest where we ARE root.
ExecStart=/bin/sh -c 'chown root:root /etc/sudoers /etc/sudoers.d /etc/sudoers.d/* 2>/dev/null || true; chmod 0440 /etc/sudoers /etc/sudoers.d/* 2>/dev/null || true; chown root:root /etc/ssh/ssh_host_* 2>/dev/null || true'

[Install]
WantedBy=sysinit.target
