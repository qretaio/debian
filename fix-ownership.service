[Unit]
Description=Mount root-owned sudo from baked sources (host rootfs uid is wrong)
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
  mkdir -p /run/piebox-sudo /run/piebox-etc && \
  mount -t tmpfs tmpfs /run/piebox-sudo && \
  mount -t tmpfs tmpfs /run/piebox-etc && \
  mkdir -p /run/piebox-etc/sudoers.d && \
  cp /opt/piebox-image/sudo/sudo /run/piebox-sudo/sudo && \
  chmod 4755 /run/piebox-sudo/sudo && \
  cp /opt/piebox-image/sudo/sudoers /opt/piebox-image/sudo/sudo.conf /run/piebox-etc/ && \
  chmod 0440 /run/piebox-etc/sudoers /run/piebox-etc/sudo.conf && \
  cp /opt/piebox-image/sudo/sudoers.d/* /run/piebox-etc/sudoers.d/ && \
  chmod 0440 /run/piebox-etc/sudoers.d/* && \
  mount --bind /run/piebox-sudo/sudo /usr/bin/sudo && \
  mount --bind /run/piebox-etc/sudoers /etc/sudoers && \
  mount --bind /run/piebox-etc/sudo.conf /etc/sudo.conf && \
  mount --bind /run/piebox-etc/sudoers.d /etc/sudoers.d'

[Install]
WantedBy=sysinit.target
